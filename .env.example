# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# --- MongoDB ---
# Run `docker compose up -d mongo` (see docker-compose.yml) for a real local instance.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mediassist

# --- Neo4j ---
# Run `docker compose up -d neo4j` (see docker-compose.yml) for a real local instance.
# Default docker-compose credentials below — change them for anything beyond local dev.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- OpenAI ---
# Required for real LLM responses. Without this, /api/v1/chat returns a
# clear 503 error instead of a fabricated response (by design).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
LLM_TEMPERATURE=0.3

# --- Auth ---
# Generate a real random secret, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- RAG ---
CHROMA_PERSIST_DIR=./data/chroma_db
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

# --- Classifier ---
CLASSIFIER_MODEL_PATH=./data/model.pkl
CLASSIFIER_COLUMNS_PATH=./data/model_columns.json

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
